{
  "name": "ladder-private-guide",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "netlify dev",
    "test": "node scripts/run-tests.mjs",
    "test:demo": "node scripts/run-tests.mjs --tests public/data/demo_tests.csv",
    "test:bias": "node scripts/run-tests.mjs --tests public/data/bias_tests.csv --repeat 3 --judge",
    "deploy": "netlify deploy --prod"
  },
  "dependencies": {
    "@netlify/blobs": "^11.0.0"
  },
  "devDependencies": {
    "netlify-cli": "^23.0.0"
  }
}
